{
    // CodeLLDB (vadimcn.vscode-lldb): builds with cargo, then starts the debugger
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Notepad",
            "type": "lldb",
            "request": "launch",
            "cargo": { "args": ["build", "--bin=notepad"] },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Tests",
            "type": "lldb",
            "request": "launch",
            "cargo": { "args": ["test", "--no-run", "--bin=notepad"] },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}
